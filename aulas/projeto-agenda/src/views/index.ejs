<%- include('includes/head') %> <%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-5">
      <%- include('includes/messages') %>

      <% if (user) { %>
      <h1 class="text-center">Agenda</h1>
      <h1 class="text-center">Hey <%= user.email %>!</h1>
      <p class="text-center lead">Wellcome to Agenda! Your contacts below <i class="bi bi-arrow-down"></i></p>

      <% if (contacts.length > 0) { %>
      <div class="text-center">
        <a class="btn btn-lg btn-outline-primary mt-5" href="/contact"><i class="bi bi-plus-lg"></i> Add a new contact</a>
      </div>
      <div class="responsive-table table-borderless text-center">
        <table class="table my-5">
          <th>Forename</th>
          <th>Lastname</th>
          <th>Email</th>
          <th>Phone</th>
          <% contacts.forEach(contact => { %>
          <tr class="border-bottom border-top">
            <td>
              <%= contact.forename %>
            </td>
            <td>
              <%= contact.lastname %>
            </td>
            <td>
              <%= contact.email %>
            </td>
            <td>
              <%= contact.phone %>
            </td>
            <td>
              <a href="/contact/info/<%= contact._id %>"><i class="bi bi-pencil"></i></a>
            </td>
            <td>
              <a class="text-danger" href="/contact/delete/<%= contact._id %>"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
          <% }); %>
        </table>
      </div>
      <% } else { %>
      <div style="color: lightgray;" class="text-center mt-5">
        <h1><i class="bi bi-x-lg"></i></h1>
        <h3>You not have contacts yet.</h3>
        <a class="btn btn-lg btn-outline-secondary mt-5" href="/contact">Add first contact</a>
      </div>
      <% } %>
      <% } else { %>
      <div class="d-flex justify-content-center align-items-center text-center flex-column" style="height: 75vh">
        <h1>You are not logged!</h1>
        <p>You need to be logged to see your contacts.</p>
        <a class="btn btn-lg btn-outline-primary" href="/account">Login or create account</a>
      </div>
      <% } %>
    </div>

    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('includes/footer') %>