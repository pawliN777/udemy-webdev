<%- include('includes/head') %> <%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-5">
      <h1 class="text-center">Contact</h1>
      <p class="text-center lead">Add or edit contacts!</p>

      <%- include('includes/messages') %>

      <% if (contact._id) { %>
      <form action="/contact/edit/<%= contact._id %>" method="POST">
        <% } else { %>
        <form action="/contact/register" method="POST">
          <% } %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label>Forname</label>
            <input value="<%= contact.forename %>" type="text" class="form-control" name="forename">
          </div>
          <div class="form-group">
            <label>Lastname</label>
            <input value="<%= contact.lastname %>" type="text" class="form-control" name="lastname">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input value="<%= contact.email %>" type="email" class="form-control" name="email">
          </div>
          <div class="form-group">
            <label>Phone</label>
            <input value="<%= contact.phone %>" type="tel" class="form-control" name="phone">
          </div>
          <% if (contact._id) { %>
          <button type="submit" class="btn btn-primary">Edit</button>
          <% } else { %>
          <button type="submit" class="btn btn-primary">Add</button>
          <% } %>
        </form>

        <div class="col-lg-2"></div>
    </div>
  </div>

  <%- include('includes/footer') %>